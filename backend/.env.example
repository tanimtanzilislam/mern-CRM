# Copy this file to ".env" and fill in your own values

# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/mern_crm

# MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mern_crm?retryWrites=true&w=majority

PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
